generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id         Int      @id @default(autoincrement())
  pool       String
  gender     String
  category   String
  sortOrder  Int      @default(0) @map("sort_order")
  discipline String
  time       String
  athlete    String
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([pool, gender, category, discipline], name: "recordKey")
  @@map("records")
}

model RecordApplication {
  id           Int       @id @default(autoincrement())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  gender       String
  pool         String
  category     String
  discipline   String
  time         String
  // Where the record was swum, and the link to the official results.
  competition  String    @default("")
  location     String    @default("")
  proofUrl     String    @map("proof_url")
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()
  // Clerk user id + display name of the admin who approved/denied it.
  reviewerId   String?   @map("reviewer_id")
  reviewerName String?   @map("reviewer_name")

  @@map("record_applications")
}

model Article {
  id          Int       @id @default(autoincrement())
  // URL part of /news/<slug>, generated from the title.
  slug        String    @unique
  title       String
  // One of ARTICLE_CATEGORIES in server/lib/news.js.
  category    String
  excerpt     String    @default("")
  // Path of an uploaded image (/api/media/<id>), or null.
  coverImage  String?   @map("cover_image")
  // HTML produced by the admin panel's editor.
  content     String    @default("")
  status      String    @default("draft")
  // Visible on the site once status is "published" and this date has passed.
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  // Clerk user id + display name of the admin who created it.
  authorId    String?   @map("author_id")
  authorName  String?   @map("author_name")
  // Email to every registered account about this article: null = never queued
  // (drafts, and articles from before this feature), "pending" = goes out once
  // the article is live, "sending", "sent". Only the first publish queues it.
  emailStatus String?   @map("email_status")

  @@index([status, publishedAt])
  @@map("articles")
}

// Images and PDFs uploaded from the article editor, served by /api/media/<id>.
model Media {
  id         String   @id
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  data       Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  uploaderId String?  @map("uploader_id")

  @@map("media")
}

// A competition in the calendar. Club accounts submit them while the
// registration window is open; admins review them (and can add
// their own, which are approved right away). Only approved ones are public.
model Competition {
  id            Int       @id @default(autoincrement())
  // One of SPORTS in server/lib/competitions.js.
  sport         String    @default("swimming")
  name          String
  // Organizer. clubId points at a Club; null when an admin
  // typed an organizer that isn't a club (e.g. the federation itself).
  clubId        Int?      @map("club_id")
  clubName      String    @map("club_name")
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime  @map("end_date") @db.Date
  // "HH:MM", optional.
  startTime     String?   @map("start_time")
  city          String
  venue         String    @default("")
  // SC (25m), LC (50m) or OW (open water).
  course        String
  // Who can take part: age groups, entry standards…
  criteria      String    @default("")
  description   String    @default("")
  entryDeadline DateTime? @map("entry_deadline") @db.Date
  infoUrl       String?   @map("info_url")
  contactName   String    @default("") @map("contact_name")
  contactEmail  String    @default("") @map("contact_email")
  contactPhone  String    @default("") @map("contact_phone")
  // pending → approved / denied, or "changes" when an admin asked the club
  // to fix something (the club edits it and it goes back to pending).
  status        String    @default("pending")
  // "club" (public form) or "admin".
  source        String    @default("club")
  // Unused since clubs edit from their account (was the emailed edit link's
  // secret); still required, so new rows get a random one. Never sent out.
  editToken     String    @unique @map("edit_token")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz()
  reviewerId    String?   @map("reviewer_id")
  reviewerName  String?   @map("reviewer_name")

  @@index([sport, status, startDate])
  @@map("competitions")
}

// Messages an admin emailed to the club about a competition (change requests,
// denial reasons), kept so the admin panel can show the history.
model CompetitionMessage {
  id            Int      @id @default(autoincrement())
  competitionId Int      @map("competition_id")
  // "changes", "denied" or "approved" — what the admin did when sending it.
  kind          String
  body          String
  authorName    String?  @map("author_name")
  emailed       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([competitionId])
  @@map("competition_messages")
}

// When clubs may submit competitions, one row per sport (set in the admin panel).
model CompetitionWindow {
  sport     String   @id
  // The calendar year the clubs are registering competitions for.
  season    Int
  opensAt   DateTime @map("opens_at") @db.Timestamptz()
  closesAt  DateTime @map("closes_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("competition_windows")
}

// Clubs. The federation's original list is copied in from
// server/db/clubs-seed.json the first time the server starts (see
// server/lib/clubs.js); clubs that sign up themselves are added as "pending"
// and become public once an admin approves them.
model Club {
  // Not autoincrement: the seeded clubs keep their old ids (club accounts and
  // competitions point at them), new clubs get max(id) + 1.
  id        Int      @id
  name      String
  city      String   @default("")
  // e.g. "Пливачки клуб", "Пливачки ватерполо клуб"
  type      String   @default("")
  address   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  president String   @default("")
  // "approved" (public, may register competitions) or "pending" (a sign-up
  // waiting for an admin).
  status    String   @default("approved")
  // The federation's own test club: works like any club but is never public.
  test      Boolean  @default(false)
  // What the club wrote to the federation when signing up.
  note      String   @default("")
  // Clerk user who signed the club up; null for the federation's list.
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([status])
  @@map("clubs")
}

// A criteria PDF on a sport's Criteria page (/swimming/criteria,
// /distance-swimming/criteria), managed in the admin panel's Criteria tab.
// The file itself is a Media row (served by /api/media/<mediaId>).
model CriteriaDocument {
  id          Int      @id @default(autoincrement())
  // One of CRITERIA_SPORTS in server/lib/criteria.js.
  sport       String
  title       String
  // Short line under the title, e.g. "Грац · 50м базен". Optional.
  description String   @default("")
  mediaId     String   @map("media_id")
  // Lower comes first on the page.
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  // Display name of the admin who last changed it.
  updatedBy   String?  @map("updated_by")

  @@index([sport, sortOrder])
  @@map("criteria_documents")
}

// One-time data imports that already ran (e.g. "criteria-pdfs"), so they
// never run twice — even after an admin deletes what they imported.
model SeedRun {
  name  String   @id
  ranAt DateTime @default(now()) @map("ran_at") @db.Timestamptz()

  @@map("seed_runs")
}
