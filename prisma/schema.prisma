generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id         Int      @id @default(autoincrement())
  pool       String
  gender     String
  category   String
  sortOrder  Int      @default(0) @map("sort_order")
  discipline String
  time       String
  athlete    String
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([pool, gender, category, discipline], name: "recordKey")
  @@map("records")
}

model RecordApplication {
  id           Int       @id @default(autoincrement())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  gender       String
  pool         String
  category     String
  discipline   String
  time         String
  proofUrl     String    @map("proof_url")
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz()
  // Clerk user id + display name of the admin who approved/denied it.
  reviewerId   String?   @map("reviewer_id")
  reviewerName String?   @map("reviewer_name")

  @@map("record_applications")
}

model Article {
  id          Int       @id @default(autoincrement())
  // URL part of /news/<slug>, generated from the title.
  slug        String    @unique
  title       String
  // One of ARTICLE_CATEGORIES in server/lib/news.js.
  category    String
  excerpt     String    @default("")
  // Path of an uploaded image (/api/media/<id>), or null.
  coverImage  String?   @map("cover_image")
  // HTML produced by the admin panel's editor.
  content     String    @default("")
  status      String    @default("draft")
  // Visible on the site once status is "published" and this date has passed.
  publishedAt DateTime? @map("published_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  // Clerk user id + display name of the admin who created it.
  authorId    String?   @map("author_id")
  authorName  String?   @map("author_name")

  @@index([status, publishedAt])
  @@map("articles")
}

// Images and PDFs uploaded from the article editor, served by /api/media/<id>.
model Media {
  id         String   @id
  filename   String
  mimeType   String   @map("mime_type")
  size       Int
  data       Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  uploaderId String?  @map("uploader_id")

  @@map("media")
}
