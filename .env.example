# Postgres connection string — REQUIRED.
# From your own machine use the Railway Postgres DATABASE_PUBLIC_URL
# (the plain DATABASE_URL with postgres.railway.internal only works inside Railway).
DATABASE_URL=
# --- Clerk (admin login) --- REQUIRED. Clerk dashboard → Configure → API keys.
# Secret key: server only, never expose it to the browser.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Same publishable key again, VITE_-prefixed so the frontend build can read it.
VITE_CLERK_PUBLISHABLE_KEY=
# Server port (Railway sets this automatically).
PORT=3001
# --- API service (Railway) ---
# Comma-separated browser origins allowed to call the API with credentials.
# Set this to your Vercel site URL, e.g. https://pfm-mk.vercel.app
# Leave empty for local dev (the Vite proxy makes requests same-origin).
CLIENT_ORIGIN=
# --- Frontend build (Vercel) ---
# Absolute base URL of the API. Set this in the Vercel project's env vars,
# e.g. https://pfm-mk-api.up.railway.app   (must be VITE_-prefixed for Vite).
# Leave empty locally so requests go through the dev proxy.
VITE_API_URL=
# --- Email (API service on Railway) ---
# Calendar emails to clubs (approved / changes needed / denied) are sent through
# Resend (https://resend.com) — Railway blocks normal SMTP on the Hobby plan.
# Leave RESEND_API_KEY empty locally: emails are then only printed in the console.
RESEND_API_KEY=
# Sender shown to clubs; the domain must be verified in Resend.
MAIL_FROM="Национална пливачка федерација <info@npf.mk>"
# Where clubs' replies go, and where "new submission" notices are sent.
MAIL_REPLY_TO=info@npf.mk
FEDERATION_EMAIL=info@npf.mk
# Public site address used in email links (edit link, calendar link).
SITE_URL=https://npf.mk
